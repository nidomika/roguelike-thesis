@startuml component_diagram
left to right direction
skinparam linetype ortho
skinparam componentStyle rectangle

skinparam package {
    BackgroundColor LightGray
    BorderColor Black
    FontSize 12
    FontStyle bold
    Padding 15
}

title Diagram komponentów

package "Game" {
    [Game Manager]
}

package "Map" {
    [Map Manager]
    [BSP Generator]
    [Corridor Generator]
}

package "Characters" {
    [Player]
    [Enemy]
    [FSM]
}

package "Combat" {
    [Hitbox]
    [Weapon]
}

package "Rooms" {
    [Room]
    [Spawner]
    [Door]
}

package "UI" {
    [UI Manager]
    [Hearts]
}

[Game Manager] -down-> [Map Manager]
[Game Manager] -down-> [UI Manager]

[Map Manager] -down-> [BSP Generator]
[Map Manager] -down-> [Corridor Generator]
[Map Manager] -down-> [Room]

[Room] -down-> [Spawner]
[Room] -down-> [Door]

[Spawner] -down-> [Enemy]

[Enemy] -down-> [FSM]
[Enemy] -down-> [Hitbox]
[Player] -down-> [Weapon]
[Player] -down-> [FSM]

[Weapon] -down-> [Hitbox]

[UI Manager] -down-> [Hearts]

@enduml